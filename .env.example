# Host port for the web app + API
PARLEY_HTTP_PORT=8080

# ICE servers for WebRTC (JSON). Add a TURN server for peers behind strict NATs, e.g.
# PARLEY_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
PARLEY_ICE_SERVERS=[]

# Set to true when running behind a reverse proxy (for correct client IPs in rate limiting)
PARLEY_TRUST_PROXY=false
PARLEY_LOG_LEVEL=info
