{
  "name": "parley",
  "private": true,
  "version": "0.1.0",
  "description": "End-to-end encrypted peer-to-peer chat (X3DH + Double Ratchet over WebRTC)",
  "type": "module",
  "workspaces": [
    "packages/crypto",
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "start": "npm run start --workspace server",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "npm run build && playwright test"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  },
  "license": "MIT",
  "author": "Kaushal Chenguttuvan"
}
